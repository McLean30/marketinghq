# Copy to .env (gitignored) and fill in on your own machine, in your own editor. Never commit .env or paste the key into chat.
# Live AI (Milestone 11A): OpenAI, server-side only. Live calls also need owner sign-in (HQ_OWNER_PASSWORD_HASH below);
# with a key but no owner sign-in, HQ stays in demo mode so nobody else can spend.
OPENAI_API_KEY=
# Optional. Defaults shown.
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536
# Shared workspace and owner sign-in. Set with: npm run set-password (stores only a hash).
HQ_OWNER_PASSWORD_HASH=
# 0.0.0.0 lets your phone reach the server over your own Wi-Fi. Leave as 127.0.0.1 for laptop-only.
HOST=127.0.0.1
# Shared workspace in Supabase (required on Vercel; optional on your own machine, where files under ./data are used).
# SUPABASE_SECRET_KEY is the project's secret key (sb_secret_...), server-side only. Never the publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: keep separate workspaces in one project (default main).
HQ_WORKSPACE_ID=main
