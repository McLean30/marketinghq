# Copy to .env (gitignored) and fill in on your own machine. Never commit .env or paste the key into chat.
ANTHROPIC_API_KEY=
# Optional. Defaults shown.
QUILL_MODEL=claude-sonnet-5-5
QUILL_EFFORT=medium
# Shared workspace (milestone 4). Set with: npm run set-password (stores only a hash). Leave empty for local demo only.
HQ_OWNER_PASSWORD_HASH=
# 0.0.0.0 lets your phone reach the server over your own Wi-Fi. Leave as 127.0.0.1 for laptop-only.
HOST=127.0.0.1
